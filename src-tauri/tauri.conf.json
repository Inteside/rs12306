{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rs12306",
  "version": "0.1.0",
  "identifier": "com.rs12306.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rs12306-login",
        "width": 800,
        "height": 600,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "create": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}